#!/usr/bin/env python3
"""On-screen indicator for the hyprvoice daemon.

Subscribes to the daemon's status stream over its control socket and draws a
layer-shell surface showing what the daemon is doing, plus the transcript as it
is recognised: confirmed text at full opacity, the unconfirmed tail dimmed.

The daemon does not need this process. It is a plain client, so it can be
started, stopped or crash without affecting dictation.
"""

from __future__ import annotations

import argparse
import ctypes.util
import json
import math
import os
import socket
import sys
import threading
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path

# gtk4-layer-shell works by intercepting the Wayland registry, so it has to be
# loaded before libwayland-client. A C program gets that from link order; a
# language binding dlopens it too late and the compositor then looks like it
# has no layer shell at all. Re-exec once with the preload in place.
_PRELOAD_GUARD = "HYPRVOICE_OVERLAY_PRELOADED"


def _reexec_with_layer_shell_preloaded() -> None:
    if os.environ.get(_PRELOAD_GUARD):
        return

    library = ctypes.util.find_library("gtk4-layer-shell")
    if not library:
        return  # let the missing-support message explain it later

    env = dict(os.environ)
    env[_PRELOAD_GUARD] = "1"
    preload = env.get("LD_PRELOAD", "")
    env["LD_PRELOAD"] = f"{library}:{preload}" if preload else library

    os.execve(sys.executable, [sys.executable, os.path.abspath(__file__), *sys.argv[1:]], env)


_reexec_with_layer_shell_preloaded()

import gi  # noqa: E402

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Pango", "1.0")

from gi.repository import (  # noqa: E402
    Gdk,
    GLib,
    Gtk,
    Gtk4LayerShell as LayerShell,
    Pango,
)

try:
    import cairo
except ImportError:  # pragma: no cover - only affects click-through
    cairo = None

# Single-byte command that opens the daemon's status stream.
STREAM_COMMAND = b"w\n"

# How long to wait before dialing the daemon again after the stream drops.
RECONNECT_SECONDS = 2

# How long an error stays on screen once the pipeline is idle again.
ERROR_LINGER_MS = 4000

# Levels arrive far faster than they need to be drawn; this many are kept for
# the meter, oldest first.
METER_BARS = 28

# Where the meter puts its zero, in dBFS. Speech RMS sits low in 0..1, so a
# linear bar spends its whole life on the floor and the meter reads as dead.
# Measuring from a noise floor instead spends the height on the range a voice
# actually occupies.
METER_FLOOR_DB = -50.0

# How many 32 ms windows are averaged into one reading. Levels arrive about
# thirty times a second, which is more often than the dots need to move.
WINDOWS_PER_BAR = 4

# The dots, in pixels: diameter when silent, diameter at full scale, and the
# space between them.
DOT_COUNT = 5
DOT_MIN_PX = 4.0
DOT_MAX_PX = 14.0
DOT_GAP_PX = 5.0

# How far each dot follows the voice. The middle ones move most, which reads
# as a single shape breathing rather than five separate meters.
DOT_WEIGHTS = (0.5, 0.78, 1.0, 0.78, 0.5)

# Share of the distance to a new level covered per update. Lower is smoother
# and laggier; at 1.0 the dots snap and the whole thing twitches.
DOT_EASE = 0.35

STATUS_LABELS = {
    "recording": "Listening",
    "transcribing": "Listening",
    "processing": "Polishing",
    "injecting": "Typing",
}

# The transcript column, in characters. The label is pinned to this width in
# both directions so words do not reflow sideways as they land.
TRANSCRIPT_COLUMN_CHARS = 44

# How far the transcript grows before it stops and scrolls instead.
TRANSCRIPT_LINES = 4

# Width of the status word, in characters, wide enough for the longest of them
# ("Transcribing"). Reserved so the pill is one size whatever it says.
STATUS_CHARS = 12

# Dictation without punctuation never stops growing, so only the newest of it
# is shown. Roughly the character budget of the lines above.
TRANSCRIPT_BUDGET = TRANSCRIPT_COLUMN_CHARS * TRANSCRIPT_LINES

ELLIPSIS = "\u2026"

